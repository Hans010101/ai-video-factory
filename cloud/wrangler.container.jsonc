{
  // AI 视频工厂 · 云端渲染容器
  //
  // 与 wrangler.jsonc（控制面）分开部署：控制面全在免费额度内，容器是
  // 唯一收费的一环（Workers Paid $5/月起，按 vCPU-秒 / GiB-秒计费）。
  // 分开的好处是控制面可以随便改随便发，不会连带触发容器重建。
  //
  // 计费要点：内存与磁盘按「预置量」计费而非实际用量，所以容器必须能
  // 休眠。sleepAfter 让它在空闲后自动停机，只在真正渲染时产生费用。
  // 常驻轮询的话 8GB 容器一个月约 $55，按需唤醒约 $5–15。
  "name": "ai-video-factory-renderer",
  "main": "src/container.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  "containers": [
    {
      "class_name": "RendererContainer",
      // 直接引用已推送并验证过的镜像：wrangler 本地重建会用 cloud/ 作构建
      // 上下文（拷不到仓库根的 lib/ tools/ config.yaml），且以 301KB/s 的
      // 上行重传 786MB 代价过高。
      "image": "registry.cloudflare.com/bc38e5e2276c7d1f104801bd888a138c/ai-video-factory-renderer:amd64",
      // Cloudflare 规定前 4 个 vCPU 每个至少配 3GiB 内存 —— 4 vCPU 就必须
      // 12GiB，配 8GiB 会被 VALIDATE_INPUT 拒绝。
      // 这里选 2 vCPU / 6GiB：渲染够用，且内存按预置量计费，12GiB 常驻的
      // 账单是 6GiB 的两倍。
      // 磁盘另有约束：不得超过内存的 2 倍，6GiB 内存对应上限 12GB。
      // 镜像 786MB + 素材缓存，12GB 绰绰有余。
      "instance_type": {
        "vcpu": 2,
        "memory_mib": 6144,
        "disk_mb": 12000
      },
      "max_instances": 2
    }
  ],

  "durable_objects": {
    "bindings": [
      { "class_name": "RendererContainer", "name": "RENDERER" }
    ]
  },

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RendererContainer"] }
  ],

  "observability": { "enabled": true }
}
